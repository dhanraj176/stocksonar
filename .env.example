NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEC EDGAR User-Agent (#14), format: "StockSonar your-email@example.com"
SEC_USER_AGENT=
# Report writer: gemini (the default when unset) or claude
REPORT_PROVIDER=
# Gemini API key (Google AI Studio), needed for REPORT_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: Gemini model, default gemini-3.5-flash-lite
GEMINI_MODEL=
# Optional: Anthropic key, only needed for REPORT_PROVIDER=claude
ANTHROPIC_API_KEY=
# Finnhub API key (finnhub.io, free Personal Use plan) for quotes and company news (#16). Server-only.
FINNHUB_API_KEY=
