{
  "permissions": {
    "allow": [
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Edit(./package.json)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
